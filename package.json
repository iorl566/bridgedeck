{
  "name": "browser-bridge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "BridgeDeck：用命令行驱动本机已登录的 Chromium 浏览器（MV3 扩展 + 本地 daemon/CLI，零依赖）",
  "bin": {
    "bridge": "cli/bridge.mjs"
  },
  "exports": {
    "./sdk": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.mjs"
    }
  },
  "scripts": {
    "status": "node cli/bridge.mjs status",
    "startup": "node tools/startup.mjs",
    "e2e": "node tools/e2e.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "audit:unused": "node tools/unused-extension-modules.mjs",
    "audit:ui": "node tools/ui-button-audit.mjs",
    "check:protocol-docs": "node tools/protocol-sections.mjs --fail",
    "selftest:cli": "node tests/cli/selftest.mjs",
    "selftest:overlay": "node tools/overlay-dom-selftest.mjs",
    "selftest:ws": "node tests/ws-selftest.mjs",
    "selftest:ext": "node tests/extension/mock-daemon.mjs",
    "make:icons": "node tools/make-icons.mjs",
    "build:extension": "node tools/build-extension.mjs",
    "verify:extension-package": "node tools/verify-extension-package.mjs",
    "publish:edge": "node tools/edge-publish.mjs",
    "build:portable": "node tools/package-portable.mjs",
    "build:portable:stage": "node tools/package-portable.mjs --stage-only --json",
    "build:macos-pkg": "sh tools/build-macos-pkg.sh",
    "sign:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/sign-windows.ps1",
    "sign:macos": "sh tools/sign-macos.sh",
    "notarize:macos": "sh tools/notarize-macos.sh",
    "release:manifest": "node tools/release.mjs",
    "test": "node tests/cli/selftest.mjs && node tests/extension/module-load.mjs && node tests/extension/page-guard.mjs && node tests/plugin/selftest.mjs && node tests/ws-selftest.mjs && node tests/mcp/selftest.mjs && node tests/pairing/selftest.mjs && node tests/tls/selftest.mjs && node tools/overlay-dom-selftest.mjs && node tools/e2e.mjs",
    "selftest:plugin": "node tests/plugin/selftest.mjs",
    "check:plugin-profile": "node tools/plugin-profile-check.mjs",
    "selftest:extension-load": "node tests/extension/module-load.mjs",
    "selftest:page-guard": "node tests/extension/page-guard.mjs",
    "mcp": "node mcp/server.mjs",
    "selftest:mcp": "node tests/mcp/selftest.mjs",
    "selftest:pairing": "node tests/pairing/selftest.mjs",
    "selftest:tls": "node tests/tls/selftest.mjs",
    "build:page-lib": "node tools/build-page-lib.mjs",
    "check:page-lib": "node tools/build-page-lib.mjs --check",
    "audit:deps": "node tools/deps-audit.mjs --check",
    "bench:vom": "node tools/vom-bench.mjs --check",
    "audit:schema": "node tools/schema-audit.mjs --check",
    "brand:scan": "node tools/release-brand-scan.mjs",
    "pack:o200k": "node tools/pack-o200k.mjs",
    "check:o200k": "node tools/pack-o200k.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
