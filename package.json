{
  "name": "browser-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "BridgeDeck：用命令行驱动本机已登录的 Chromium 浏览器（MV3 扩展 + 本地 daemon/CLI，零依赖）",
  "bin": {
    "bridge": "cli/bridge.mjs"
  },
  "scripts": {
    "status": "node cli/bridge.mjs status",
    "e2e": "node tools/e2e.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "audit:parity": "node tools/audit-source-parity.mjs",
    "manifest:parity": "node tools/parity-manifest.mjs",
    "check:parity": "node tools/parity-manifest.mjs --check",
    "selftest:cli": "node tests/cli/selftest.mjs",
    "selftest:browser": "node tools/content-browser-selftest.mjs",
    "selftest:overlay": "node tools/overlay-browser-selftest.mjs",
    "selftest:input": "node tools/cooperation-trusted-input-selftest.mjs",
    "selftest:ws": "node tests/ws-selftest.mjs",
    "selftest:ext": "node tests/extension/mock-daemon.mjs",
    "make:icons": "node tools/make-icons.mjs",
    "test": "node tests/cli/selftest.mjs && node tests/extension/module-load.mjs && node tests/plugin/selftest.mjs && node tests/ws-selftest.mjs && node tests/mcp/selftest.mjs && node tests/pairing/selftest.mjs && node tests/tls/selftest.mjs && node tools/content-browser-selftest.mjs && node tools/overlay-browser-selftest.mjs && node tools/cooperation-trusted-input-selftest.mjs && node tools/e2e.mjs",
    "selftest:plugin": "node tests/plugin/selftest.mjs",
    "check:plugin-profile": "node tools/plugin-profile-check.mjs",
    "selftest:extension-load": "node tests/extension/module-load.mjs",
    "mcp": "node mcp/server.mjs",
    "selftest:mcp": "node tests/mcp/selftest.mjs",
    "selftest:pairing": "node tests/pairing/selftest.mjs",
    "selftest:tls": "node tests/tls/selftest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
