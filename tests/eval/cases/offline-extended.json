[
  {
    "id": "offline-rpc-act-fill",
    "title": "直连：browser_act fill 走协议 fill 并按 ref/value 传参",
    "capability": "plugin.rpc-routing",
    "oracleLevel": "offline-fake",
    "expectedStatus": "passed",
    "mode": "tool",
    "tool": "browser_act",
    "args": { "action": "fill", "ref": "@e1", "value": "hello 世界", "sessionId": "s1" },
    "script": { "handlers": { "fill": { "result": { "ok": true, "ref": "@e1", "value": "hello 世界", "steps": 2 } } } },
    "expect": "passed",
    "assert": { "ok": true, "value": "hello 世界", "steps": 2 },
    "evidence": ["value"],
    "expectRpc": [{ "method": "fill", "params": { "ref": "@e1", "value": "hello 世界" } }],
    "expectCallCount": 1,
    "evidenceRule": "fill 证据必须包含真实写入值；rpc 参数必须命中 fill 方法"
  },
