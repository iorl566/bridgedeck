  {
    "id": "offline-rpc-observe-vom",
    "title": "直连：observe 带 vom/facts/ax，本地 grep 过滤且保留结构化节点",
    "capability": "plugin.rpc-routing",
    "oracleLevel": "offline-fake",
    "expectedStatus": "passed",
    "mode": "tool",
    "tool": "browser_observe",
    "args": { "sessionId": "s1", "vom": true, "facts": true, "ax": true, "grep": "提交" },
    "script": {
      "handlers": {
        "observe": {
          "result": {
            "url": "https://example.test/form",
            "title": "表单",
            "refs": 3,
            "observation": "- button \"提交\" [@e1]\n- link \"取消\" [@e2]\n- textbox \"备注\" [@e3]",
            "nodes": [{ "ref": "@e1", "role": "button", "name": "提交" }],
            "facts": { "@e1": { "visible": true, "bounds": { "x": 1, "y": 2 } } },
            "tables": [{ "rows": 1, "columns": ["a"] }],
            "unmappedAx": [{ "backendNodeId": 42, "role": "button" }]
          }
        }
      }
    },
    "expect": "passed",
    "assert": { "refs": 3, "nodes.0.name": "提交", "tables.0.rows": 1, "unmappedAx.0.backendNodeId": 42 },
    "contains": { "observation": "提交" },
    "evidence": ["observation", "nodes"],
    "expectRpc": [{ "method": "observe", "params": { "vom": true, "facts": true, "ax": true } }],
    "evidenceRule": "结构化节点与过滤后的 observation 都必须来自真实返回；grep 不应丢 refs 计数"
  },
